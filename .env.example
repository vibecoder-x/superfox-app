# Server only. Create a NEW provider key after revoking the exposed credential.
DEEPSEEK_API_KEY=replace_with_a_new_provider_key

# Optional developer preview only, with npm run dev. Disabled by default.
# This flag NEVER enables chat in a production build or public deployment.
# Preview questions are sent to DeepSeek; do not enter real children's data.
SUPERFOX_CHAT_PREVIEW_ENABLED=false
